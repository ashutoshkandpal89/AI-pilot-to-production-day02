# Trainer Note:
# This repo runs entirely on mock data - none of these variables are
# required for any demo to work. They exist so students see exactly where
# real Azure AI Foundry project credentials would go if this repo's mock
# functions (in shared/, demo*_*/) were swapped for real Foundry SDK calls.

# Azure AI Foundry project connection (not used by any demo in this repo)
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_FOUNDRY_API_KEY=<your-api-key>

# Optional: Entra ID app registration, for a real deployment's calling-user
# identity resolution (see demo1_grounding/permission_filter.py for the
# mock equivalent of this concept)
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<your-client-id>
AZURE_CLIENT_SECRET=<your-client-secret>
